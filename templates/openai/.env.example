# Placeholder only. Never insert real credentials in this example file.
# Set the key that matches fastagent.yaml. Delete the unused model-key line before deploy.
# openrouter/<vendor>/<model> requires OPENROUTER_API_KEY.
# openai/<model> requires OPENAI_API_KEY.
OPENROUTER_API_KEY=
# Generate at least 32 random bytes as base64url. This authorizes every conversation for this app.
FASTAGENT_API_TOKEN=
# Production requires the exact external HTTPS origin (no trailing slash). Leave unset on first deploy.
APP_ORIGIN=
# Runtime-only user-supplied Redis URL. Production requires rediss:// (TLS).
REDIS_URL=
# Optional non-secret FASTAGENT_HISTORY_NAMESPACE overrides fastagent.yaml name.
# Use the same validated app ID across all replicas/revisions; never reuse it for a different app.
# Local HTTP is allowed only with explicit FASTAGENT_LOCAL_DEV=1 on localhost.
